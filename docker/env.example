# Copy to ../deploy/.env (outside of any git repository) and fill in.

# Random secret for session cookies:  uv run lifeos secret
LIFEOS_SESSION_SECRET=

# Argon2 hash of your login password:  uv run lifeos hash-password
# Keep the single quotes — the hash contains `$` characters.
LIFEOS_PASSWORD_HASH=''

# Set to true once the app is served over HTTPS.
LIFEOS_COOKIE_SECURE=false

# GitHub tickets (optional). Classic token with the scopes `repo` and `project`:
#   https://github.com/settings/tokens/new?scopes=repo,project&description=LifeOS
# LIFEOS_GITHUB_TOKEN=
# Repositories to mirror (comma-separated) and the Projects v2 boards (owner/number,
# comma-separated). The first board is the primary one (tasks); the applications board
# (LIFEOS_APPLICATIONS_PROJECT) is added automatically.
# LIFEOS_GITHUB_REPOS=you/board
# LIFEOS_GITHUB_PROJECTS=you/1

# Presentations from OneDrive (optional, see docs/vault.md → Presentations).
# Application id of your Entra app (personal accounts, public client, Files.Read):
# LIFEOS_MS_CLIENT_ID=
# OneDrive folder to mirror, and the knowledge hub folder that receives the notes:
# LIFEOS_ONEDRIVE_FOLDER=Presentations
# LIFEOS_PRESENTATIONS_DIR=Presentations
# LIFEOS_STATE_DIR is set to /state by compose.yml (mounted from ../deploy/state).

# Moodle (optional, see docs/vault.md → Moodle). Sign in on the Moodle page of the app.
# LIFEOS_MOODLE_URL=https://moodle.example.edu
# LIFEOS_MOODLE_DIR=Moodle
# Time zone for due dates (Moodle deadlines, task facts):
# LIFEOS_TIMEZONE=Europe/Vienna

# Vault git sync (server only, see docs/architecture.md → Vault sync). Seconds between
# runs of `lifeos worker` (commit, pull --rebase, push). 0 or unset disables it.
# LIFEOS_GIT_SYNC_INTERVAL=300
# Daily Moodle sync by the worker (HH:MM in LIFEOS_TIMEZONE), committed as `moodle: …`.
# LIFEOS_MOODLE_SYNC_AT=05:00

# MCP server for ChatGPT and other assistants (study tools), served at
# https://<host>/mcp/<token>/ . Random, >= 32 characters: uv run lifeos secret
# Treat the URL like a password; OAuth will replace it.
# LIFEOS_MCP_PATH_TOKEN=

# Job search (see docs/architecture.md → Job search). Bearer token for the importer on
# the PC (POST /api/jobsearch/import/*). Random, >= 32 characters: uv run lifeos secret
# LIFEOS_JOBSEARCH_IMPORT_TOKEN=
# On the PC only: where the importer sends postings (same token as above).
# LIFEOS_JOBSEARCH_SERVER_URL=https://lifeos.example.org

# Job applications board (see docs/architecture.md → Applications). Create it with
#   docker compose exec worker lifeos applications setup-board
# LIFEOS_APPLICATIONS_PROJECT=owner/number
# Repository for application issues (default: the first of LIFEOS_GITHUB_REPOS):
# LIFEOS_APPLICATIONS_REPO=owner/board
# Seconds between board checks of the worker; 0 or unset = off:
# LIFEOS_APPLICATIONS_INTERVAL=120

# AI teammates (see docs/architecture.md → AI teammates on the boards): seconds between
# rounds (mirror boards/ contracts to GitHub, agents take their tickets); 0 = off.
# Try once by hand first: docker compose exec worker lifeos agents sync
# LIFEOS_AGENTS_INTERVAL=120
# The worker also reads deploy/agents.env (if present) for ANTHROPIC_API_KEY.
# Cost in agent reports is converted from USD with this rate:
# LIFEOS_AGENTS_EUR_PER_USD=0.9

# Local development only: skip the login screen.
# LIFEOS_AUTH_DISABLED=true
