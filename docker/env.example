# Copy to ../deploy/.env (outside of any git repository) and fill in.

# Random secret for session cookies:  uv run lifeos secret
LIFEOS_SESSION_SECRET=

# Argon2 hash of your login password:  uv run lifeos hash-password
# Keep the single quotes — the hash contains `$` characters.
LIFEOS_PASSWORD_HASH=''

# Set to true once the app is served over HTTPS.
LIFEOS_COOKIE_SECURE=false

# Local development only: skip the login screen.
# LIFEOS_AUTH_DISABLED=true
