# Settings of ops/deployer.py (copy to /srv/lifeos/deploy/deployer.env on the server).
# The branch the server runs – must match LIFEOS_DEPLOY_BRANCH of the app.
LIFEOS_DEPLOY_BRANCH=main
# Defaults, change only if your layout differs:
# LIFEOS_APP_DIR=/srv/lifeos/app
# LIFEOS_CI_DIR=/srv/lifeos/ci
# LIFEOS_DEPLOY_QUEUE=/srv/lifeos/deploy/state/deploy
# LIFEOS_VAULT=/srv/lifeos/vault
# LIFEOS_HEALTH_URL=http://127.0.0.1:8000/api/health
# LIFEOS_HEALTH_SECONDS=120
